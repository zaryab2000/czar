# Secrets
*.key
*.key.json
*.pem
# Key manifests written by local runs, whatever directory they land in. The patterns below
# listed single file names (deployments/local-keys.json, .vault-client-test*, .run6-*), so a
# run that chose a new name wrote an unignored key file: PM-017's aborted run 2 left
# deployments/.signer-run2-<hex>-keys.json, which nothing ignored and nothing flagged.
*-keys.json
keys.json
!*-keys.example.json
!keys.example.json
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
cache/
out/
dist/
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
.idea/
.vscode/

# Tool output
graphify-out/

# Keys (T-001; the signer keystore lives outside the repository, D78)
keystore/
*.keystore
*.p12

# Build output (T-001)
.next/
.ponder/
contracts/out/
contracts/cache/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
apps/indexer/test/fixtures/resume/.ponder/
apps/web/next-env.d.ts


# Docs
docs-internal/

contracts/broadcast/*/31337/
contracts/slither-out.json
deployments/local.json
deployments/arc-local.json
deployments/local-keys.json

deployments/.vault-client-test*.json
contracts/broadcast
deployments/.run6-*
# Signer local-chain harness files (run 2 writes per-key files such as .signer-k8-local.json;
# an aborted run leaves them behind). They can hold key material: never commit them (PM-067).
deployments/.signer-*
