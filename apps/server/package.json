{
  "name": "@czar/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/eval.mjs",
    "start:local": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/local-main.ts",
    "social:worker": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/social/worker-main.ts",
    "social:fixture-merchants": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/fixture-merchants.ts"
  },
  "dependencies": {
    "@circle-fin/modular-wallets-core": "1.0.16",
    "@czar/api-contract": "workspace:*",
    "@czar/config": "workspace:*",
    "@czar/hashing": "workspace:*",
    "@czar/logging": "workspace:*",
    "@czar/schemas": "workspace:*",
    "@czar/signer": "workspace:*",
    "@czar/vault-client": "workspace:*",
    "@czar/x402": "workspace:*",
    "@noble/curves": "1.9.1",
    "ajv": "8.20.0",
    "cbor": "10.0.12",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
