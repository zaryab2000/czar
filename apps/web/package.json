{
  "name": "@czar/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./packages/*.ts",
    "#src/app-shell": "./packages/app-shell.tsx"
  },
  "exports": {
    "./money-format": "./packages/money-format/src/index.ts"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname localhost",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname localhost",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@circle-fin/modular-wallets-core": "1.0.16",
    "@czar/api-contract": "workspace:*",
    "@czar/hashing": "workspace:*",
    "@czar/schemas": "workspace:*",
    "@czar/vault-client": "workspace:*",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
