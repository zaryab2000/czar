{
  "name": "@czar/signer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:local": "CZAR_LOCAL_CHAIN=1 vitest run test/local-chain.test.ts",
    "start:local": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/local-main.ts",
    "start:cloud": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cloud-main.ts"
  },
  "dependencies": {
    "@czar/config": "workspace:*",
    "@czar/hashing": "workspace:*",
    "@czar/logging": "workspace:*",
    "@czar/schemas": "workspace:*",
    "@czar/vault-client": "workspace:*",
    "@napi-rs/keyring": "2.1.1",
    "pg": "8.23.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
