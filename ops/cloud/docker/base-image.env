# The one place the Czar cloud base image is named (PM-013).
#
# Every image is pinned by digest, never by tag, so a rebuild months from now
# starts from the same bytes. The tag below is the human-readable name of that
# digest; the digest is what Docker actually resolves.
#
# To resolve or refresh the digest, from a machine that can reach Docker Hub:
#
#   docker buildx imagetools inspect node:22.22.0-bookworm-slim \
#     --format '{{.Manifest.Digest}}'
#
# That prints the multi-arch index digest — the same kind of digest
# ops/local/compose.yaml pins Postgres by. Paste it as NODE_BASE_IMAGE_DIGEST
# below, keeping the tag and the digest in step.
#
# Resolved on 2026-11-05 with the command above from a machine that can reach Docker Hub.
# With the digest empty, build-all.sh refuses to build and base.Dockerfile has no usable
# FROM, so no image can be built from a floating tag by accident.

NODE_BASE_IMAGE_TAG=node:22.22.0-bookworm-slim
NODE_BASE_IMAGE_DIGEST=sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94

# pnpm comes from corepack, pinned to the version in the root package.json's
# "packageManager" field. Kept here too so the Dockerfiles need no parsing step.
PNPM_VERSION=10.28.0

# Node version the images must report, asserted by ops/cloud/test/images.test.ts
# and matching .nvmrc.
NODE_VERSION=22.22.0
