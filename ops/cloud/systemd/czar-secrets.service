[Unit]
Description=Czar: write the boot-time credential files from Secret Manager (SCR-170 §4)
Documentation=https://github.com/zaryab2000/czar/blob/main/ops/cloud/README.md
Requires=run-czar-secrets.mount
After=run-czar-secrets.mount network-online.target
Wants=network-online.target
# No container may start before its credential files exist.
Before=docker.service
# The guard must already be in place before anything asks the metadata server for a token.
After=czar-metadata-guard.service
Requires=czar-metadata-guard.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/czar/bin/fetch-secrets.sh
# No credential is ever handed to this unit through its environment or a command line (D70, D78):
# it reads names from /opt/czar/ops/secrets.list and values from Secret Manager over REST.
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
