[Unit]
Description=Czar: tmpfs for deploy.credentialFilesDir (SCR-170 §4)
Documentation=https://github.com/zaryab2000/czar/blob/main/ops/cloud/README.md
Before=czar-secrets.service docker.service

[Mount]
What=tmpfs
Where=/run/czar/secrets
Type=tmpfs
# Credential files never survive a reboot, are never executable, and carry no device nodes or
# setuid bits. 1 MiB is far more than the handful of password and token files need.
Options=mode=0755,nosuid,nodev,noexec,size=1M,strictatime

[Install]
WantedBy=multi-user.target
