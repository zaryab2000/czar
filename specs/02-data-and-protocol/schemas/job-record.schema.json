{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://czar.dev/schemas/job-record/1.0",
  "title": "JobRecord",
  "description": "An ERC-8183 job opened by the vault as client (spec 02 §4.11).",
  "type": "object",
  "x-privacyClass": "public",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Schema version, major.minor; this file is 1.0.",
      "x-privacyClass": "public",
      "const": "1.0"
    },
    "vault": {
      "$ref": "common.schema.json#/$defs/Address",
      "description": "Vault.",
      "x-privacyClass": "public"
    },
    "envelopeId": {
      "$ref": "common.schema.json#/$defs/Uint64",
      "description": "Envelope.",
      "x-privacyClass": "public"
    },
    "stepIndex": {
      "type": "integer",
      "description": "Step index.",
      "x-privacyClass": "public",
      "minimum": 0,
      "maximum": 63
    },
    "jobEscrow": {
      "$ref": "common.schema.json#/$defs/Address",
      "description": "Escrow instance (Circle testnet or CzarJobEscrow).",
      "x-privacyClass": "public"
    },
    "jobId": {
      "$ref": "common.schema.json#/$defs/Uint256String",
      "description": "The escrow's job id.",
      "x-privacyClass": "public"
    },
    "jobKey": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "keccak256(abi.encode(jobEscrow, jobId)).",
      "x-privacyClass": "public"
    },
    "provider": {
      "$ref": "common.schema.json#/$defs/Address",
      "description": "Provider.",
      "x-privacyClass": "public"
    },
    "evaluator": {
      "$ref": "common.schema.json#/$defs/Address",
      "description": "Evaluator (Czar key K7).",
      "x-privacyClass": "public"
    },
    "reservedCap": {
      "$ref": "common.schema.json#/$defs/Amount6",
      "description": "Step cap reserved at openJob.",
      "x-privacyClass": "public"
    },
    "budget": {
      "$ref": "common.schema.json#/$defs/Amount6",
      "description": "Budget from BudgetSet / getJob.",
      "x-privacyClass": "public"
    },
    "descriptionHash": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "Hash in the on-chain description string czar:<hash>.",
      "x-privacyClass": "public"
    },
    "deliverableHash": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "From JobSubmitted.",
      "x-privacyClass": "public"
    },
    "reportHash": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "The reason passed to complete or reject.",
      "x-privacyClass": "public"
    },
    "state": {
      "type": "string",
      "enum": [
        "Opened",
        "Funded",
        "Submitted",
        "Completed",
        "Rejected",
        "Expired",
        "Refunded"
      ],
      "description": "Job state.",
      "x-privacyClass": "public"
    },
    "expiredAt": {
      "$ref": "common.schema.json#/$defs/UnixSeconds",
      "description": "Job expiry.",
      "x-privacyClass": "public"
    },
    "deliverableUri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "description": "Where the evaluator fetches the deliverable: https://<provider-host>/.well-known/czar-deliverable/<deliverable-hex>. The fetched bytes must keccak256 to deliverableHash (D53).",
      "x-privacyClass": "server-only"
    }
  },
  "required": [
    "schemaVersion",
    "vault",
    "envelopeId",
    "stepIndex",
    "jobEscrow",
    "jobId",
    "jobKey",
    "provider",
    "evaluator",
    "reservedCap",
    "descriptionHash",
    "state",
    "expiredAt"
  ],
  "$comment": "Change log: 2026-10-18 AM-08/D53 added deliverableUri (.well-known convention)."
}
