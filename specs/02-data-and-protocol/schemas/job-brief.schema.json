{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://czar.dev/schemas/job-brief.schema.json",
  "title": "JobBrief",
  "description": "What an ERC-8183 provider must deliver (spec 02 \u00a74.21, RV-025). Served only to the job's provider at GET /v1/jobs/{jobKey}/brief after an EIP-712 BriefRequest signature; never public, never on-chain. Its fields are the preimage of the on-chain descriptionHash.",
  "type": "object",
  "x-privacyClass": "server-only",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version, major.minor; this file is 1.0.",
      "x-privacyClass": "server-only"
    },
    "briefVersion": {
      "type": "integer",
      "const": 1,
      "description": "Brief format version.",
      "x-privacyClass": "server-only"
    },
    "network": {
      "$ref": "common.schema.json#/$defs/Caip2",
      "description": "Chain of the job.",
      "x-privacyClass": "server-only"
    },
    "jobEscrow": {
      "$ref": "common.schema.json#/$defs/Address",
      "description": "ERC-8183 instance.",
      "x-privacyClass": "server-only"
    },
    "jobId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Escrow job id as a decimal string (uint256).",
      "x-privacyClass": "server-only"
    },
    "jobKey": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "keccak256(abi.encode(jobEscrow, jobId)) (spec 02 \u00a77.1).",
      "x-privacyClass": "server-only"
    },
    "planHash": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "descriptionHash preimage field.",
      "x-privacyClass": "server-only"
    },
    "stepIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63,
      "description": "descriptionHash preimage field.",
      "x-privacyClass": "server-only"
    },
    "acceptanceProfileId": {
      "type": "string",
      "maxLength": 80,
      "description": "descriptionHash preimage field; SL ProfileId.",
      "x-privacyClass": "server-only"
    },
    "capability": {
      "type": "string",
      "maxLength": 64,
      "description": "Capability tag.",
      "x-privacyClass": "server-only"
    },
    "inputs": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 1000
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "description": "Structured step input; keys only from the step's inputTemplate.inputKeys (RV-021). Never free user text.",
      "x-privacyClass": "server-only"
    },
    "inputSalt": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "Random per job; stops guessing low-entropy inputs from the public hash.",
      "x-privacyClass": "server-only"
    },
    "inputCommit": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "H({hashRule: czar-hash-v1, kind: job-input, inputs, inputSalt}) (spec 02 \u00a75.2).",
      "x-privacyClass": "server-only"
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mimeType",
        "uriConvention"
      ],
      "properties": {
        "mimeType": {
          "type": "string",
          "maxLength": 100,
          "description": "Expected media type.",
          "x-privacyClass": "server-only"
        },
        "expectedKeys": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 64,
            "description": "Key.",
            "x-privacyClass": "server-only"
          },
          "description": "Keys the acceptance requirement check looks for.",
          "x-privacyClass": "server-only"
        },
        "schema": {
          "type": "object",
          "description": "Optional JSON Schema the deliverable must validate against (8 KiB max when serialized).",
          "x-privacyClass": "server-only"
        },
        "uriConvention": {
          "type": "string",
          "const": "https://<provider-host>/.well-known/czar-deliverable/<deliverable-hex>",
          "description": "https://<provider-host>/.well-known/czar-deliverable/<deliverable-hex> (D53). Bytes must hash to the submitted deliverable or the job is rejected (D77).",
          "x-privacyClass": "server-only"
        }
      },
      "description": "What to submit and where.",
      "x-privacyClass": "server-only"
    },
    "budgetCap": {
      "$ref": "common.schema.json#/$defs/Amount6",
      "description": "The job's reservedCap; a setBudget above it is refused.",
      "x-privacyClass": "server-only"
    },
    "evaluator": {
      "$ref": "common.schema.json#/$defs/Address",
      "description": "Czar evaluator K7.",
      "x-privacyClass": "server-only"
    },
    "expiredAt": {
      "type": "integer",
      "minimum": 0,
      "description": "Job expiry, unix seconds.",
      "x-privacyClass": "server-only"
    },
    "issuedAt": {
      "$ref": "common.schema.json#/$defs/Timestamp",
      "description": "When the server built this response.",
      "x-privacyClass": "server-only"
    }
  },
  "required": [
    "schemaVersion",
    "briefVersion",
    "network",
    "jobEscrow",
    "jobId",
    "jobKey",
    "planHash",
    "stepIndex",
    "acceptanceProfileId",
    "capability",
    "inputs",
    "inputSalt",
    "inputCommit",
    "deliverable",
    "budgetCap",
    "evaluator",
    "expiredAt",
    "issuedAt"
  ],
  "$comment": "2026-10-19: created for RV-025."
}
