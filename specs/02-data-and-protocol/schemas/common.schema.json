{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://czar.dev/schemas/common/1.0",
  "title": "Czar common primitives",
  "description": "Shared primitive formats referenced by every Czar schema (spec 02 \u00a72.1).",
  "$defs": {
    "Amount6": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "USDC atomic units, 6 decimals, decimal integer string. Never a float, never 18-decimal native wei."
    },
    "Bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Basis points; math floors."
    },
    "Address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "description": "EIP-55 checksummed address in APIs; lowercase inside canonical JSON for hashing."
    },
    "Hash32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$",
      "description": "32-byte keccak256 hash, lowercase hex with 0x."
    },
    "Hex": {
      "type": "string",
      "pattern": "^0x([0-9a-f]{2})*$",
      "description": "Arbitrary byte string, lowercase hex with 0x."
    },
    "Caip2": {
      "type": "string",
      "pattern": "^eip155:[0-9]+$",
      "description": "CAIP-2 chain id, e.g. eip155:5042002."
    },
    "Caip10": {
      "type": "string",
      "pattern": "^eip155:[0-9]+:0x[0-9a-f]{40}$",
      "description": "CAIP-10 account id with lowercase address."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC with millisecond precision and Z suffix."
    },
    "UnixSeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix time in seconds (on-chain uint64)."
    },
    "Ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "26-character Crockford base32 ULID."
    },
    "EventId": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ActivityEvent id."
    },
    "BeliefId": {
      "type": "string",
      "pattern": "^blf_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Soul belief id."
    },
    "ObjectiveId": {
      "type": "string",
      "pattern": "^obj_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Objective id, minted by the daemon."
    },
    "PlanId": {
      "type": "string",
      "pattern": "^pln_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Plan id, minted by the server."
    },
    "StepId": {
      "type": "string",
      "pattern": "^stp_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Step id, minted by the server."
    },
    "DeviceId": {
      "type": "string",
      "pattern": "^dev_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Device id, minted at pairing."
    },
    "BatchId": {
      "type": "string",
      "pattern": "^bat_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Evidence batch id."
    },
    "PaymentId": {
      "type": "string",
      "pattern": "^pay_[0-9a-f]{32}$",
      "description": "x402 payment-identifier id (spec 02 \u00a77.4; F1-06)."
    },
    "EnvelopeRef": {
      "type": "string",
      "pattern": "^eip155:[0-9]+:0x[0-9a-f]{40}:[0-9]+$",
      "description": "Caip10(vault) + ':' + envelopeId."
    },
    "Uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615,
      "description": "Unsigned 64-bit integer."
    },
    "Uint256String": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "uint256 as a decimal string."
    },
    "Category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 32,
      "description": "Spending category, lowercase kebab-case."
    },
    "CapabilityTag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 48,
      "description": "Capability tag, lowercase kebab-case, e.g. web-search."
    },
    "SlServiceId": {
      "type": "string",
      "pattern": "^svc_[0-9a-f]{32}$",
      "description": "Selection Layer ServiceId (SL \u00a75.1)."
    },
    "SlProfileId": {
      "type": "string",
      "pattern": "^prof_[0-9a-f]{32}$",
      "description": "Selection Layer ProfileId (SL \u00a75.1)."
    },
    "SlObsId": {
      "type": "string",
      "pattern": "^obs_[0-9a-f]{32}$",
      "description": "Selection Layer ObsId (SL \u00a75.1)."
    },
    "SlReportId": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{32}$",
      "description": "Selection Layer ReportId (SL \u00a75.1)."
    },
    "SlVersionId": {
      "type": "string",
      "pattern": "^ver_[0-9a-f]{32}$",
      "description": "Selection Layer VersionId (SL \u00a75.1)."
    },
    "SlPolicyVersion": {
      "type": "string",
      "pattern": "^pol_[0-9a-f]{16}$",
      "description": "Selection Layer PolicyVersion (SL \u00a75.1)."
    }
  }
}
