{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://czar.dev/schemas/receipt.schema.json",
  "title": "Receipt",
  "description": "Buyer receipt: SL \u00a75.4 ObservationCore with kind=receipt, signed as SL \u00a75.8 Receipt (spec 02 \u00a74.13).",
  "type": "object",
  "x-privacyClass": "public",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Schema version, major.minor; this file is 1.0.",
      "x-privacyClass": "public",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "description": "Observation kind.",
      "x-privacyClass": "public",
      "const": "receipt"
    },
    "reporter": {
      "type": "object",
      "description": "Reporter (SL \u00a75.4).",
      "x-privacyClass": "public",
      "properties": {
        "kind": {
          "type": "string",
          "description": "Reporter kind.",
          "x-privacyClass": "public",
          "const": "buyer"
        },
        "id": {
          "type": "string",
          "description": "Reporter id.",
          "x-privacyClass": "public",
          "maxLength": 128
        },
        "address": {
          "$ref": "common.schema.json#/$defs/Address",
          "description": "The vault (ERC-1271 kind SL_RECEIPT) or the pocket EOA.",
          "x-privacyClass": "public"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "address"
      ]
    },
    "payment": {
      "$ref": "payment-ref.schema.json",
      "description": "PaymentRef (SL \u00a75.2).",
      "x-privacyClass": "public"
    },
    "payment_ref_hash": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "keccak256(jcs(PaymentRef)).",
      "x-privacyClass": "public"
    },
    "listed_price_atomic": {
      "$ref": "common.schema.json#/$defs/Amount6",
      "description": "Price shown before paying.",
      "x-privacyClass": "public"
    },
    "origin_asserted": {
      "type": "string",
      "description": "URL origin the reporter called.",
      "x-privacyClass": "public",
      "maxLength": 2048
    },
    "requirements_hash_seen": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "Hash of the 402 received.",
      "x-privacyClass": "public"
    },
    "request": {
      "type": "object",
      "description": "Request commit (SL \u00a75.4).",
      "x-privacyClass": "public",
      "properties": {
        "commit": {
          "$ref": "common.schema.json#/$defs/Hash32",
          "description": "requestCommit.",
          "x-privacyClass": "public"
        },
        "canonical_scheme": {
          "type": "string",
          "description": "Canonicalisation scheme.",
          "x-privacyClass": "public",
          "const": "sl-req-v1"
        },
        "size": {
          "type": "integer",
          "description": "Request size in bytes.",
          "x-privacyClass": "public",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "commit",
        "canonical_scheme",
        "size"
      ]
    },
    "response": {
      "type": "object",
      "description": "Response commit (SL \u00a75.4).",
      "x-privacyClass": "public",
      "properties": {
        "status_code": {
          "type": "integer",
          "description": "HTTP status.",
          "x-privacyClass": "public",
          "minimum": 100,
          "maximum": 599
        },
        "commit": {
          "$ref": "common.schema.json#/$defs/Hash32",
          "description": "responseCommit.",
          "x-privacyClass": "public"
        },
        "size": {
          "type": "integer",
          "description": "Response size in bytes.",
          "x-privacyClass": "public",
          "minimum": 0
        },
        "mime": {
          "type": "string",
          "description": "MIME type.",
          "x-privacyClass": "public",
          "maxLength": 128
        },
        "merchant_attestation": {
          "type": "object",
          "description": "Optional merchant DeliveryAttestation.",
          "x-privacyClass": "public",
          "properties": {
            "sig": {
              "$ref": "common.schema.json#/$defs/Hex",
              "description": "DeliveryAttestation signature.",
              "x-privacyClass": "public"
            },
            "signer": {
              "$ref": "common.schema.json#/$defs/Address",
              "description": "Signer.",
              "x-privacyClass": "public"
            },
            "ts": {
              "$ref": "common.schema.json#/$defs/UnixSeconds",
              "description": "Timestamp.",
              "x-privacyClass": "public"
            }
          },
          "additionalProperties": false,
          "required": [
            "sig",
            "signer",
            "ts"
          ]
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "description": "Timings.",
      "x-privacyClass": "public",
      "properties": {
        "t_request": {
          "$ref": "common.schema.json#/$defs/UnixSeconds",
          "description": "Request time.",
          "x-privacyClass": "public"
        },
        "t_payment_signed": {
          "$ref": "common.schema.json#/$defs/UnixSeconds",
          "description": "Authorization signed.",
          "x-privacyClass": "public"
        },
        "t_first_byte": {
          "$ref": "common.schema.json#/$defs/UnixSeconds",
          "description": "First byte.",
          "x-privacyClass": "public"
        },
        "t_complete": {
          "$ref": "common.schema.json#/$defs/UnixSeconds",
          "description": "Complete.",
          "x-privacyClass": "public"
        }
      },
      "additionalProperties": false,
      "required": [
        "t_request",
        "t_payment_signed"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "delivered",
        "http-error",
        "timeout",
        "no-response",
        "unknown",
        "skipped"
      ],
      "description": "Outcome (SL \u00a75.4).",
      "x-privacyClass": "public"
    },
    "disclosure": {
      "type": "string",
      "enum": [
        "public",
        "validator-only",
        "hash-only"
      ],
      "description": "Disclosure level; hash-only by default.",
      "x-privacyClass": "public"
    },
    "local_checks": {
      "type": "object",
      "description": "Buyer-run checks.",
      "x-privacyClass": "public",
      "properties": {
        "profile_id": {
          "$ref": "common.schema.json#/$defs/SlProfileId",
          "description": "Profile.",
          "x-privacyClass": "public"
        },
        "checks_commit": {
          "$ref": "common.schema.json#/$defs/Hash32",
          "description": "checksCommit.",
          "x-privacyClass": "public"
        }
      },
      "additionalProperties": false,
      "required": [
        "profile_id",
        "checks_commit"
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/Timestamp",
      "description": "Creation time.",
      "x-privacyClass": "public"
    },
    "obs_id": {
      "$ref": "common.schema.json#/$defs/SlObsId",
      "description": "obs_ + keccak of the core (SL \u00a75.1).",
      "x-privacyClass": "public"
    },
    "sig": {
      "$ref": "common.schema.json#/$defs/Hex",
      "description": "EIP-712 Receipt signature (SL \u00a75.8); for the vault, the SL_RECEIPT envelope bytes.",
      "x-privacyClass": "public"
    },
    "envelopeRef": {
      "$ref": "common.schema.json#/$defs/EnvelopeRef",
      "description": "Czar envelope (server-only).",
      "x-privacyClass": "server-only"
    },
    "stepIndex": {
      "type": "integer",
      "description": "Czar step index (server-only).",
      "x-privacyClass": "server-only",
      "minimum": 0,
      "maximum": 63
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "reporter",
    "payment",
    "payment_ref_hash",
    "origin_asserted",
    "outcome",
    "disclosure",
    "created_at",
    "obs_id",
    "sig"
  ]
}
