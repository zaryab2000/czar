+/** Accept only a seller receipt amount bounded by the signed authorization. */
+function sellerReportedUptoAmount(
+  receipt: string | undefined,
+  authorizedMaximum: string,
+): string | undefined {
+  if (!receipt) return undefined
+  try {
+    const decoded = JSON.parse(
+      Buffer.from(receipt, 'base64').toString('utf-8'),
+    ) as {
+      amount?: unknown
+      payload?: { amount?: unknown }
+    }
+    const amount = decoded.amount ?? decoded.payload?.amount
+    if (
+      typeof amount !== 'string' ||
+      !/^\d+$/.test(amount) ||
+      BigInt(amount) > BigInt(authorizedMaximum)
+    )
+      return undefined
+    return formatUsdcAmount(amount)
+  } catch {
+    return undefined
+  }
+}
