+const PAYMENT_IDENTIFIER = 'payment-identifier'
+const PAYMENT_ID_PATTERN = /^[a-zA-Z0-9_-]{16,128}$/
+
+/** Echo declared extensions and assign a stable identifier before signing. */
+
+function prepareExtensions(
+  extensions: Record<string, unknown> | undefined,
+  paymentId: string | null,
+  x402Version: number,
+): Record<string, unknown> | undefined {
+  if (paymentId !== null && x402Version !== 2) {
+    throw new Error('--payment-id is supported only by x402 version 2.')
+  }
+  if (paymentId !== null && extensions?.[PAYMENT_IDENTIFIER] === undefined) {
+    throw new Error(
+      '--payment-id requires an advertised payment-identifier extension.',
+    )
+  }
+  if (!extensions) return undefined
+  const copy = structuredClone(extensions)
+  const identifier = copy[PAYMENT_IDENTIFIER]
+  if (identifier === undefined) return copy
+  const info = (identifier as { info: Record<string, unknown> }).info
+  const id =
+    paymentId ??
+    (typeof info.id === 'string' ? info.id : randomUUID().replaceAll('-', ''))
+  if (!PAYMENT_ID_PATTERN.test(id)) {
+    throw new Error(
+      'Invalid --payment-id: use 16-128 alphanumeric, hyphen, or underscore characters.',
+    )
+  }
+  info.id = id
+  return copy
+}
