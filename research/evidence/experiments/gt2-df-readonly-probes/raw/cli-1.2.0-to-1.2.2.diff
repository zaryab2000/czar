+/** Fail closed unless the selected wallet already approved the full ceiling. */
+async function verifyPermit2Allowance(
+  session: { client: CircleHttpClient },
+  owner: string,
+  blockchain: string,
+  option: PaymentOption,
+  args: string[],
+): Promise<boolean> {
+  try {
+    const { outputData } = await session.client.queryContract({
+      address: option.asset,
+      blockchain,
+      abiFunctionSignature: 'allowance(address,address)',
+      abiParameters: [owner, PERMIT2_ADDRESS],
+    })
+    if (!/^0x[0-9a-fA-F]{64}$/.test(outputData))
+      throw new Error('malformed output')
+    const [allowance] = decodeAbiParameters(
+      parseAbiParameters('uint256'),
+      outputData as `0x${string}`,
+    )
+    if (allowance < BigInt(option.amount)) {
+      outputError(
+        `USDC allowance to Permit2 is below the authorized maximum ${formatUsdcAmount(option.amount)}.`,
+        args,
+        'INVALID_ARGUMENT',
+        `Approve ${PERMIT2_ADDRESS} from the selected wallet first; Circle CLI will not create an approval automatically.`,
+      )
+      process.exitCode = 1
+      return false
+    }
+    return true
+  } catch (err) {
+    outputError(
+      "Could not verify the selected wallet's token allowance to Permit2.",
+      args,
+      'INTERNAL',
+      `No payment was signed. Verify the allowance for ${option.asset} on ${blockchain} and retry. (${stringifyError(err)})`,
+    )
+    process.exitCode = 1
+    return false
+  }
