{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://czar.dev/schemas/plan.schema.json",
  "title": "Plan",
  "description": "The priced plan for one objective (spec 02 §4.5). What the user approves; planHash is written into the envelope.",
  "type": "object",
  "x-privacyClass": "server-only",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Schema version, major.minor; this file is 1.1. 1.1 (2026-10-19) adds pocket, pocket leaves (kind 4) and the pocketCapBps rule (D71), and Step.inputTemplate.inputKeys (RV-021).",
      "x-privacyClass": "server-only",
      "const": "1.1"
    },
    "planId": {
      "$ref": "common.schema.json#/$defs/PlanId",
      "description": "Plan id.",
      "x-privacyClass": "server-only"
    },
    "objectiveId": {
      "$ref": "common.schema.json#/$defs/ObjectiveId",
      "description": "Objective id.",
      "x-privacyClass": "server-only"
    },
    "objectiveHash": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "objectiveHash.",
      "x-privacyClass": "hash-on-chain"
    },
    "planHash": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "planHash per spec 02 §5.2.",
      "x-privacyClass": "hash-on-chain"
    },
    "network": {
      "$ref": "common.schema.json#/$defs/Caip2",
      "description": "Chain.",
      "x-privacyClass": "hash-on-chain"
    },
    "category": {
      "$ref": "common.schema.json#/$defs/Category",
      "description": "Spending category; categoryId = keccak256(utf8(category)) on-chain.",
      "x-privacyClass": "hash-on-chain"
    },
    "cap": {
      "$ref": "common.schema.json#/$defs/Amount6",
      "description": "Envelope cap = sum of step caps × (1 + slack).",
      "x-privacyClass": "hash-on-chain"
    },
    "slackBps": {
      "$ref": "common.schema.json#/$defs/Bps",
      "description": "Slack over the step caps; default 2500.",
      "x-privacyClass": "hash-on-chain"
    },
    "maxStepAmount": {
      "$ref": "common.schema.json#/$defs/Amount6",
      "description": "Maximum over step caps.",
      "x-privacyClass": "hash-on-chain"
    },
    "pocketCapBps": {
      "$ref": "common.schema.json#/$defs/Bps",
      "description": "Pocket cap in bps of cap: 0 unless the plan has a gateway-nano step, then 2500 (D22, D71).",
      "x-privacyClass": "hash-on-chain"
    },
    "pocket": {
      "$ref": "common.schema.json#/$defs/Address",
      "description": "Pocket EOA for the plan's gateway-nano steps; present if and only if such a step exists; committed in payeeLeaves as a kind-4 leaf (D71).",
      "x-privacyClass": "hash-on-chain"
    },
    "expiresAt": {
      "$ref": "common.schema.json#/$defs/Timestamp",
      "description": "Envelope expiry.",
      "x-privacyClass": "hash-on-chain"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "description": "Steps.",
      "x-privacyClass": "server-only",
      "maxItems": 64
    },
    "payeeLeaves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PayeeLeaf"
      },
      "description": "Plan payees plus at most two alternates per step (D36).",
      "x-privacyClass": "hash-on-chain"
    },
    "payeeRoot": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "Merkle root of payeeLeaves (spec 02 §5.3).",
      "x-privacyClass": "public"
    },
    "rankingDecisionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "SL query_id.",
        "x-privacyClass": "server-only",
        "maxLength": 128
      },
      "description": "Selection Layer decisions used.",
      "x-privacyClass": "server-only"
    },
    "shadow": {
      "type": "boolean",
      "description": "True for shadow-mode pricing (no envelope).",
      "x-privacyClass": "server-only"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/Timestamp",
      "description": "Creation time.",
      "x-privacyClass": "server-only"
    },
    "droppedSteps": {
      "type": "array",
      "description": "Steps the planner removed before approval, with the reason (D82: agent-assist with no agent host).",
      "x-privacyClass": "server-only",
      "maxItems": 64,
      "items": {
        "type": "object",
        "description": "A dropped step.",
        "x-privacyClass": "server-only",
        "additionalProperties": false,
        "required": [
          "capability",
          "reason"
        ],
        "properties": {
          "capability": {
            "$ref": "common.schema.json#/$defs/CapabilityTag",
            "description": "Capability of the dropped step.",
            "x-privacyClass": "server-only"
          },
          "reason": {
            "type": "string",
            "enum": [
              "no-agent"
            ],
            "description": "Why it was dropped.",
            "x-privacyClass": "server-only"
          }
        }
      }
    },
    "marketReference": {
      "type": "object",
      "description": "Shadow plans only (D83 point 7): real-market prices per capability from the MarketView; never used for payment.",
      "x-privacyClass": "server-only",
      "additionalProperties": false,
      "required": [
        "network",
        "perCapability"
      ],
      "properties": {
        "network": {
          "$ref": "common.schema.json#/$defs/Caip2",
          "description": "selection.marketNetwork.",
          "x-privacyClass": "server-only"
        },
        "perCapability": {
          "type": "array",
          "maxItems": 64,
          "description": "One row per paid capability.",
          "x-privacyClass": "server-only",
          "items": {
            "type": "object",
            "description": "Market prices for one capability.",
            "x-privacyClass": "server-only",
            "additionalProperties": false,
            "required": [
              "capability",
              "ready"
            ],
            "properties": {
              "capability": {
                "$ref": "common.schema.json#/$defs/CapabilityTag",
                "description": "Capability.",
                "x-privacyClass": "server-only"
              },
              "ready": {
                "type": "integer",
                "minimum": 0,
                "description": "Tier-ready services.",
                "x-privacyClass": "server-only"
              },
              "low": {
                "$ref": "common.schema.json#/$defs/Amount6",
                "description": "Lowest live price.",
                "x-privacyClass": "server-only"
              },
              "median": {
                "$ref": "common.schema.json#/$defs/Amount6",
                "description": "Median live price.",
                "x-privacyClass": "server-only"
              }
            }
          }
        }
      }
    },
    "taskSpec": {
      "$ref": "task-spec.schema.json",
      "description": "The TaskSpec this plan was built from, including approval-screen edits (D84).",
      "x-privacyClass": "server-only"
    },
    "fillInPlace": {
      "type": "boolean",
      "default": true,
      "description": "Write found values into the person's file in place of the recorded placeholders (D85); set on the approval screen.",
      "x-privacyClass": "server-only"
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "objectiveId",
    "objectiveHash",
    "planHash",
    "network",
    "category",
    "cap",
    "slackBps",
    "maxStepAmount",
    "pocketCapBps",
    "expiresAt",
    "steps",
    "payeeLeaves",
    "payeeRoot",
    "shadow",
    "createdAt"
  ],
  "$defs": {
    "Step": {
      "type": "object",
      "description": "One step of a plan (spec 02 §4.6).",
      "x-privacyClass": "server-only",
      "properties": {
        "stepIndex": {
          "type": "integer",
          "description": "Position; used in PayeeLeaf.",
          "x-privacyClass": "hash-on-chain",
          "minimum": 0,
          "maximum": 63
        },
        "stepId": {
          "$ref": "common.schema.json#/$defs/StepId",
          "description": "Step id.",
          "x-privacyClass": "server-only"
        },
        "kind": {
          "type": "string",
          "enum": [
            "x402-exact",
            "gateway-nano",
            "erc8183-job",
            "local",
            "agent-assist",
            "tip"
          ],
          "description": "Payment path from the router (spec 01 §8.7, D37); tip is Phase 2; local and agent-assist are unpaid (D82, spec 02 §4.6.1).",
          "x-privacyClass": "server-only"
        },
        "capability": {
          "$ref": "common.schema.json#/$defs/CapabilityTag",
          "description": "Capability this step provides.",
          "x-privacyClass": "server-only"
        },
        "serviceId": {
          "$ref": "common.schema.json#/$defs/SlServiceId",
          "description": "Selection Layer service id.",
          "x-privacyClass": "server-only"
        },
        "resource": {
          "type": "object",
          "description": "The merchant endpoint.",
          "x-privacyClass": "server-only",
          "properties": {
            "url": {
              "type": "string",
              "description": "Merchant endpoint URL.",
              "x-privacyClass": "server-only",
              "format": "uri",
              "maxLength": 2048
            },
            "method": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "DELETE"
              ],
              "description": "HTTP method.",
              "x-privacyClass": "server-only"
            }
          },
          "additionalProperties": false,
          "required": [
            "url",
            "method"
          ]
        },
        "payee": {
          "$ref": "common.schema.json#/$defs/Address",
          "description": "payTo or job provider; absent for local and agent-assist steps (D82).",
          "x-privacyClass": "hash-on-chain"
        },
        "alternates": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Address",
            "description": "Alternate payee.",
            "x-privacyClass": "hash-on-chain"
          },
          "description": "Up to two ranked alternates (D36).",
          "x-privacyClass": "hash-on-chain",
          "maxItems": 2
        },
        "unitAmount": {
          "$ref": "common.schema.json#/$defs/Amount6",
          "description": "Expected price per call from the live 402 (p1-D7).",
          "x-privacyClass": "hash-on-chain"
        },
        "expectedCalls": {
          "type": "integer",
          "description": "Expected number of calls; batch size n (D37).",
          "x-privacyClass": "server-only",
          "minimum": 1
        },
        "stepCap": {
          "$ref": "common.schema.json#/$defs/Amount6",
          "description": "Per-step cap, at least unitAmount × expectedCalls.",
          "x-privacyClass": "hash-on-chain"
        },
        "routingReason": {
          "type": "string",
          "description": "Why the router chose this kind, e.g. below-pocket-threshold.",
          "x-privacyClass": "server-only",
          "maxLength": 128
        },
        "acceptanceProfileId": {
          "$ref": "common.schema.json#/$defs/SlProfileId",
          "description": "Acceptance profile (SL §5.5).",
          "x-privacyClass": "server-only"
        },
        "inputTemplate": {
          "type": "object",
          "description": "Structured input only; never user text (spec 01 §11.2 layer 3). Optional expectedKeys names the output keys the requirement check needs (AM-09). inputKeys names the only keys a pay call may send for this step (RV-021).",
          "x-privacyClass": "server-only",
          "properties": {
            "expectedKeys": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "maxLength": 64,
                "description": "Key the merchant output must contain.",
                "x-privacyClass": "server-only"
              },
              "description": "Keys the requirement check (CZ-16) and the reader (P-02 expectedFields) look for in the output.",
              "x-privacyClass": "server-only"
            },
            "inputKeys": {
              "type": "array",
              "maxItems": 20,
              "description": "The only input keys a pay call may send for this step, with their types and limits (RV-021).",
              "x-privacyClass": "server-only",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "type"
                ],
                "description": "One allowed input key.",
                "x-privacyClass": "server-only",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                    "description": "Key name.",
                    "x-privacyClass": "server-only"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "string",
                      "number",
                      "boolean"
                    ],
                    "description": "Value type.",
                    "x-privacyClass": "server-only"
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "Maximum string length (strings only).",
                    "x-privacyClass": "server-only"
                  },
                  "enum": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "description": "Allowed values, when the key is an enum.",
                    "x-privacyClass": "server-only"
                  }
                }
              }
            }
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "integer",
            "description": "Step index this step depends on.",
            "x-privacyClass": "server-only",
            "minimum": 0,
            "maximum": 63
          },
          "description": "Dependencies.",
          "x-privacyClass": "server-only"
        },
        "fanOut": {
          "type": "string",
          "enum": [
            "none",
            "subjects"
          ],
          "description": "subjects: one call per TaskSpec subject (D84).",
          "x-privacyClass": "server-only"
        },
        "callInputs": {
          "type": "array",
          "maxItems": 128,
          "description": "Concrete input per call, rendered by CZ-13 from inputTemplate and the TaskSpec; {{dep.*}} values are filled at run time (D84).",
          "x-privacyClass": "server-only",
          "items": {
            "type": "object",
            "description": "One call's input.",
            "x-privacyClass": "server-only",
            "additionalProperties": false,
            "required": [
              "callIndex",
              "input"
            ],
            "properties": {
              "callIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127,
                "description": "Call index within the step.",
                "x-privacyClass": "server-only"
              },
              "subjectIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 49,
                "description": "TaskSpec subject this call serves.",
                "x-privacyClass": "server-only"
              },
              "input": {
                "type": "object",
                "description": "Key/value input sent to the merchant; values are strings, numbers or booleans, or a {{dep.<stepIndex>.<field>}} reference.",
                "x-privacyClass": "server-only",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        },
        "contextNotice": {
          "type": "string",
          "enum": [
            "task-description-only"
          ],
          "description": "Shown on the approval screen for a job step whose provider gets only the task description and TaskSpec context, no files (D86; Phase 1 has no file sharing).",
          "x-privacyClass": "server-only"
        }
      },
      "additionalProperties": false,
      "required": [
        "stepIndex",
        "stepId",
        "kind",
        "capability",
        "unitAmount",
        "expectedCalls",
        "stepCap",
        "routingReason",
        "acceptanceProfileId"
      ]
    },
    "PayeeLeaf": {
      "type": "object",
      "description": "A payee leaf of payeeRoot (spec 02 §4.7, §5.3).",
      "x-privacyClass": "public",
      "properties": {
        "payee": {
          "$ref": "common.schema.json#/$defs/Address",
          "description": "Payee address.",
          "x-privacyClass": "public"
        },
        "kind": {
          "type": "integer",
          "description": "1 x402 payTo, 2 ERC-8183 provider, 3 tip repo (Phase 2), 4 pocket EOA (D71).",
          "x-privacyClass": "public",
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "stepIndex": {
          "type": "integer",
          "description": "Step index 0-63 for kinds 1-3; 4294967295 (POCKET_STEP_INDEX) for kind 4.",
          "x-privacyClass": "public",
          "minimum": 0,
          "maximum": 4294967295
        },
        "stepCap": {
          "$ref": "common.schema.json#/$defs/Amount6",
          "description": "Per-step cap shared by the payee and its alternates (D36), enforced per step on-chain (RV-002); \"0\" for kind 4.",
          "x-privacyClass": "public"
        }
      },
      "additionalProperties": false,
      "required": [
        "payee",
        "kind",
        "stepIndex",
        "stepCap"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": 4
              }
            }
          },
          "then": {
            "properties": {
              "stepIndex": {
                "const": 4294967295
              },
              "stepCap": {
                "const": "0"
              }
            }
          },
          "else": {
            "properties": {
              "stepIndex": {
                "maximum": 63
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "Change log: 2026-10-18 AM-09 added inputTemplate.expectedKeys."
}
