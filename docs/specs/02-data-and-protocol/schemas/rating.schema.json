{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://czar.dev/schemas/rating.schema.json",
  "title": "Rating",
  "description": "The paying owner's good or bad on one producing step of one delivered objective, bound to every settled receipt of that step (spec 02 §4.28, SCR-160). The only supplier quality signal.",
  "type": "object",
  "x-privacyClass": "server-only",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version, major.minor; this file is 1.0.",
      "x-privacyClass": "server-only"
    },
    "ratingId": {
      "$ref": "common.schema.json#/$defs/RatingId",
      "description": "Server-minted id.",
      "x-privacyClass": "server-only"
    },
    "userId": {
      "type": "string",
      "maxLength": 64,
      "description": "The owner who rated.",
      "x-privacyClass": "server-only"
    },
    "vault": {
      "$ref": "common.schema.json#/$defs/Address",
      "description": "The vault that paid every bound receipt.",
      "x-privacyClass": "server-only"
    },
    "objectiveId": {
      "$ref": "common.schema.json#/$defs/ObjectiveId",
      "description": "The delivered objective.",
      "x-privacyClass": "server-only"
    },
    "stepIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63,
      "description": "The producing step (Result.provenance entry with accepted = true).",
      "x-privacyClass": "server-only"
    },
    "network": {
      "$ref": "common.schema.json#/$defs/Caip2",
      "description": "From the bound receipts.",
      "x-privacyClass": "server-only"
    },
    "serviceId": {
      "$ref": "common.schema.json#/$defs/SlServiceId",
      "description": "The supplier, from the bound receipts.",
      "x-privacyClass": "server-only"
    },
    "versionId": {
      "type": "string",
      "pattern": "^(ver_[0-9a-f]{32}|ver_unknown)$",
      "description": "The service version at call time, or ver_unknown.",
      "x-privacyClass": "server-only"
    },
    "taskClass": {
      "type": "string",
      "maxLength": 128,
      "description": "Task class of the step.",
      "x-privacyClass": "server-only"
    },
    "value": {
      "type": "string",
      "enum": [
        "good",
        "bad"
      ],
      "description": "The owner's judgement. Binary; never a number.",
      "x-privacyClass": "server-only"
    },
    "obsIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "common.schema.json#/$defs/SlObsId",
        "description": "A bound receipt.",
        "x-privacyClass": "server-only"
      },
      "description": "Every eligible receipt of the step at write time; resolved by the server, never trusted from the client.",
      "x-privacyClass": "server-only"
    },
    "surface": {
      "type": "string",
      "enum": [
        "cli",
        "web"
      ],
      "description": "Set by the route that accepted the rating.",
      "x-privacyClass": "server-only"
    },
    "supersedes": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/RatingId"
        },
        {
          "type": "null"
        }
      ],
      "description": "The owner's earlier rating for the same objective and step that this one corrects; at most one correction per step.",
      "x-privacyClass": "server-only"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/Timestamp",
      "description": "Server time.",
      "x-privacyClass": "server-only"
    }
  },
  "required": [
    "schemaVersion",
    "ratingId",
    "userId",
    "vault",
    "objectiveId",
    "stepIndex",
    "network",
    "serviceId",
    "versionId",
    "taskClass",
    "value",
    "obsIds",
    "surface",
    "supersedes",
    "createdAt"
  ]
}
