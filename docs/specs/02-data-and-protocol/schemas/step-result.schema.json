{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://czar.dev/schemas/step-result.schema.json",
  "title": "StepResult",
  "description": "The only form in which untrusted merchant output leaves the reader; goes to the paying agent, acceptance and write-back (including the D82 assembler), never to the planner (spec 02 §4.15, D74).",
  "type": "object",
  "x-privacyClass": "server-only",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Schema version, major.minor; this file is 1.1 (SCR-160: one StepResult per paid call; callIndex, subjectIndex, obsId).",
      "x-privacyClass": "server-only",
      "const": "1.1"
    },
    "stepIndex": {
      "type": "integer",
      "description": "Step index.",
      "x-privacyClass": "server-only",
      "minimum": 0,
      "maximum": 63
    },
    "callIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095,
      "description": "The paid call within the step: the authorization index (vault-direct), the nanopayment index (pocket) or 0 (job). SCR-160.",
      "x-privacyClass": "server-only"
    },
    "subjectIndex": {
      "type": "integer",
      "minimum": 0,
      "description": "The TaskSpec subject this call served (D84); absent for one-subject kinds.",
      "x-privacyClass": "server-only"
    },
    "obsId": {
      "$ref": "common.schema.json#/$defs/SlObsId",
      "description": "obs_ + keccak256(dedupKey)[0:32] of this call's payment (spec 02 §7.1, SCR-160).",
      "x-privacyClass": "server-only"
    },
    "status": {
      "type": "string",
      "enum": [
        "delivered",
        "http-error",
        "timeout",
        "no-response",
        "unknown"
      ],
      "description": "Outcome vocabulary (SL).",
      "x-privacyClass": "server-only"
    },
    "source": {
      "type": "object",
      "description": "Where the text came from.",
      "x-privacyClass": "server-only",
      "properties": {
        "origin": {
          "type": "string",
          "description": "Merchant origin.",
          "x-privacyClass": "server-only",
          "maxLength": 2048
        },
        "payTo": {
          "$ref": "common.schema.json#/$defs/Address",
          "description": "Payee.",
          "x-privacyClass": "server-only"
        },
        "paymentRefHash": {
          "$ref": "common.schema.json#/$defs/Hash32",
          "description": "Payment reference hash.",
          "x-privacyClass": "server-only"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "payTo",
        "paymentRefHash"
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Extracted field.",
        "x-privacyClass": "server-only",
        "properties": {
          "name": {
            "type": "string",
            "description": "Field name.",
            "x-privacyClass": "server-only",
            "maxLength": 64
          },
          "value": {
            "type": "string",
            "description": "Extracted value; data, never instructions.",
            "x-privacyClass": "server-only",
            "maxLength": 2000
          },
          "confidence": {
            "type": "number",
            "description": "Reader confidence 0 to 1.",
            "x-privacyClass": "server-only",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "confidence"
        ]
      },
      "description": "Extracted values.",
      "x-privacyClass": "server-only",
      "maxItems": 50
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "injection-suspect",
          "schema-mismatch",
          "truncated",
          "pii-suspect"
        ],
        "description": "Flag.",
        "x-privacyClass": "server-only"
      },
      "description": "Flags from the screen and reader.",
      "x-privacyClass": "server-only"
    },
    "bodyRef": {
      "type": "string",
      "description": "Object-store key of the raw body; never inlined.",
      "x-privacyClass": "server-only",
      "maxLength": 512
    },
    "bodyCommit": {
      "$ref": "common.schema.json#/$defs/Hash32",
      "description": "SL responseCommit.",
      "x-privacyClass": "hash-on-chain"
    }
  },
  "required": [
    "schemaVersion",
    "stepIndex",
    "callIndex",
    "obsId",
    "status",
    "source",
    "fields",
    "flags",
    "bodyCommit"
  ]
}
