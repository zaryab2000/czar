{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "types": ["node"],
    "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true, "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "verbatimModuleSyntax": true
  },
  "include": ["*.ts"]
}
